{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The room server: one Durable Object per room code, served at /parties/main/:room.
  "name": "werewolves",
  "main": "party/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    // Binding "Main" maps to the default "main" party that partysocket connects to.
    // "Account" is the "account" party: one per signed-in account (party/account.ts).
    "bindings": [
      { "name": "Main", "class_name": "RoomServer" },
      { "name": "Account", "class_name": "AccountServer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomServer"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountServer"] }
  ],
  // Accounts: the room server checks the site's tickets (lib/ticket.ts) with
  // the TICKET_KEY secret, and saves stats to POSTGRES_URL. Both are set by
  // the Vercel build (scripts/deploy-server.mjs); `wrangler dev` reads
  // .env.local. Without a key, signing in is off.
  "env": {
    // npx wrangler deploy --env staging  →  werewolves-staging.<subdomain>.workers.dev
    "staging": {
      "name": "werewolves-staging",
      "durable_objects": {
        "bindings": [
          { "name": "Main", "class_name": "RoomServer" },
          { "name": "Account", "class_name": "AccountServer" }
        ]
      }
    }
  }
}
