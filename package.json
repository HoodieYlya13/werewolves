{
  "name": "werewolves",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,party -c blue,magenta \"npm:dev:next\" \"npm:dev:party\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:next": "next dev --hostname 0.0.0.0",
    "dev:party": "wrangler dev --port 1999 --ip 0.0.0.0",
    "party:deploy": "wrangler deploy",
    "typecheck": "npm run party:types && tsc --noEmit && tsc --noEmit -p party",
    "test": "vitest run",
    "test:watch": "vitest",
    "party:deploy:staging": "wrangler deploy --env staging",
    "party:types": "wrangler types party/worker-configuration.d.ts"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
