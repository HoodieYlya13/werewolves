{
  "name": "werewolves",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,party -c blue,magenta \"npm:dev:next\" \"npm:dev:party\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:next": "next dev --hostname 0.0.0.0",
    "dev:party": "partykit dev",
    "party:deploy": "partykit deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "partysocket": "^1.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "partykit": "^0.0.115",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
