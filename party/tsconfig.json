{
  // The room server runs on Cloudflare Workers, not in the browser or Node.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": { "@/*": ["../*"] }
  },
  "include": ["*.ts", "../lib/engine/**/*.ts", "../lib/protocol.ts", "../lib/protocol-schemas.ts", "../lib/ballot.ts", "../lib/account.ts", "../lib/stats.ts", "../lib/ticket.ts", "../lib/auto/**/*.ts", "../lib/roles/**/*.ts", "../lib/steps/**/*.ts", "../lib/soundtrack.ts", "../lib/sound-types.ts", "../lib/themes/*.ts", "../lib/i18n/config.ts", "../lib/i18n/dictionaries/*.ts", "../lib/i18n/game-texts.ts", "../lib/i18n/localized-texts.ts", "../lib/deep-merge.ts"],
  "exclude": ["*.test.ts", "../lib/**/*.test.ts"]
}
